<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PlcDbSnapshot</AssemblyName>
    <RootNamespace>PlcDbSnapshot.App</RootNamespace>
    <Version>0.1.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\S7CommPlusDriver\S7CommPlusDriver.csproj" />
    <ProjectReference Include="..\PlcDbSnapshot.Core\PlcDbSnapshot.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Plain framework references instead of UseWindowsForms, so the project also builds with non-Windows SDKs (CI). -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- OpenSSL is P/Invoked by the driver and must sit next to the exe. -->
    <None Include="..\..\third_party\S7CommPlusDriver\src\S7CommPlusDriver\OpenSSL-dll-x64\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
